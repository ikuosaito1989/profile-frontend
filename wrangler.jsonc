{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "profile-frontend",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2025-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public"
  },
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  // 秘密でない値のみ。APIキーは vars に置かず、シークレットとして登録する:
  //   npx wrangler secret put NUXT_RESEND_API_KEY
  "vars": {
    "NUXT_PUBLIC_SITE_URL": "https://profile-frontend.ikuosaito1989.workers.dev",
    "NUXT_PUBLIC_META_IMAGE": "/ogp.png",
    "NUXT_PUBLIC_TITLE": "斉藤育男（ikuosaito1989）のプロフィール",
    "NUXT_PUBLIC_DESCRIPTION": "ikuosaito1989としてGitHub・Qiita・Zennで活動する、斉藤育男（Ikuo Saito）のプロフィール、経歴、スキル、ポートフォリオを紹介します。",
    "NUXT_MAIL_SUPPORT": "info@noreply.ol-car.com",
    "NUXT_MAIL_SUPPORT_NAME": "olcar サポートチーム",
    "NUXT_MAIL_ADMIN": "ikuosaito1989@gmail.com"
  }
}
